# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Ignore any `build/` output directory at any depth.
**/build/
/build/
**/.dart_tool/

# FVM (Flutter Version Management)
# Commit .fvmrc (the version pin) but ignore the local SDK symlink cache.
.fvm/

# Melos / pub workspace
# Melos may generate these path-based overrides which conflict with Dart pub
# workspaces. This repo resolves packages via `workspace:` + `resolution: workspace`,
# so these must never be committed.
**/pubspec_overrides.yaml
# Only the root lockfile is authoritative in a pub workspace.
**/packages/**/pubspec.lock
**/apps/**/pubspec.lock

# Coverage
coverage/

# Test reports (JUnit XML for Codecov Test Analytics)
**/junit.xml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
